# Fixes taps landing in the corner on multi-touch panels without the hid-multitouch driver (see touchfix.py).
#   sudo apt install -y python3-evdev
#   sudo cp deploy/touchfix.py /usr/local/bin/touchfix.py
#   sudo cp deploy/touchfix.service /etc/systemd/system/
#   sudo systemctl enable --now touchfix
[Unit]
Description=Scoreboard touch screen fix
After=systemd-udev-settle.service
Before=getty@tty1.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/touchfix.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
